###################### DATA DIRECTORY ######################

data-dir folder="EX_S4-4-data-files"

####################### DESCRIPTION ########################

description text="description.txt"

######################### DETAILS ##########################

simulation start=0 end=100 timestep=0.1 param-output-max=100000

inference start=0 end=100 timestep=0.5 nchain=3

post-sim start=0 end=100

########## DEFINE MODEL AND DATA FOR SPECIES FARM ##########

species name="Farm" type="individual"

# SPECIES MODEL

class name="DS" index="d"

comp name="S" color="#009900" x=-16 y=0

comp name="I" color="#ff2222" x=0 y=0

comp name="R" color="#4444ff" x=16 y=0

trans name="S->I" value="exp(rate:exp(-φ×f_l(t))×βΣ_l'[l,30] (M_l,l'×{I,l'}))"

trans name="I->R" value="gamma(mean:m, cv:c)"

class name="Location" index="l"

view x=150 y=104.5 grid="on" scale=0.11722

comp-all color="#000099" fix="true" file="comp_Location.csv"

# SIMULATION INITIAL CONDITIONS

add-ind-sim name="Added individuals" file="add-ind-sim.csv"

######################## PARAMETERS ########################

param name="c" value=0.3 prior="power(0.01,1,-2)"

param name="m" value=10 prior="inverse(1,20)"

param name="α" value=2.5 prior="uniform(1,4)"

param name="β" value=3 prior="inverse(0.01,5)"

param name="Δ" value=5 prior="uniform(0,20)"

param name="φ" value=1.5

param name="f_l(t)" dynamic-sim="bin-thresh-dist({I}, index:l, dist:30, thresh:0)" knot-times="start,10,20,30,40,50,60,70,80,90,end" spline-type="square"

param name="M_l,l'" reparam="1/(1+pow(D_l,l'/Δ|α))"

