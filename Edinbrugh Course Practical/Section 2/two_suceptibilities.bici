####################### DESCRIPTION ########################

description text="# Model and analysis description."

######################### DETAILS ##########################

simulation start=0 end=100 timestep=1

inference start=0 end=100 timestep=1 nchain=3

post-sim

########## DEFINE MODEL AND DATA FOR SPECIES FISH ##########

species name="Fish" type="individual"

# SPECIES MODEL

class name="DS" index="a"

comp name="S^a" color="#00bb00" x=-11 y=6

comp name="S^b" color="#22ff22" x=-11 y=-3

comp name="I" color="#ff2222" x=2 y=1

comp name="R" color="#4444ff" x=14 y=1

trans name="S^a->I" value="exp(rate:β^a×{I}/N)"

trans name="S^b->I" value="exp(rate:β^b×{I}/N)"

trans name="I->R" value="exp(rate:γ)"

# SIMULATION INITIAL CONDITIONS

init-pop-sim type="fixed" focal="DS" file="[[
"Compartment","Population"
"S^a",100
"S^b",100
"I",1
"R",0
]]"

